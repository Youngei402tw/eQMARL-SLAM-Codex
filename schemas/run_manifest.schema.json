{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eQMARL-SLAM run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "protocol_id",
    "hypothesis",
    "method",
    "status",
    "source_commit",
    "dirty_tree",
    "config_sha256",
    "seed_streams",
    "split_manifests",
    "runtime",
    "model",
    "quantum",
    "budget",
    "resources_consumed",
    "evaluation",
    "artifacts",
    "failure",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{2}-[A-Za-z0-9][A-Za-z0-9_.-]+$"
    },
    "stage": {
      "type": "string",
      "enum": [
        "00",
        "01",
        "02",
        "03",
        "04",
        "05",
        "06",
        "07",
        "08",
        "09"
      ]
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "failed",
        "stopped_budget",
        "abandoned",
        "interrupted",
        "invalidated"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirty_tree": {
      "const": false
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_streams": {
      "type": "object",
      "required": [
        "model_init",
        "critic_init",
        "map",
        "evaluation_map",
        "sensor",
        "action",
        "quantum_shots",
        "communication"
      ],
      "description": "Independent explicit seeds or generator states, plus seed-manifest hashes; unused streams are null."
    },
    "split_manifests": {
      "type": "object",
      "required": [
        "train",
        "development",
        "validation",
        "test"
      ],
      "description": "Paths and hashes; unused splits are explicitly null. Final test access is separately logged."
    },
    "runtime": {
      "type": "object",
      "required": [
        "python",
        "lockfile_sha256",
        "platform",
        "hardware",
        "dependencies"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "actor",
        "encoder",
        "critic",
        "parameter_counts",
        "optimizer"
      ]
    },
    "quantum": {
      "type": [
        "object",
        "null"
      ],
      "description": "Null for classical; otherwise device, wires, shots, diff_method, dtype, entanglement, observables, noise and resource accounting."
    },
    "budget": {
      "type": "object",
      "required": [
        "profile",
        "primitive_steps",
        "wall_seconds"
      ]
    },
    "resources_consumed": {
      "type": "object",
      "required": [
        "primitive_steps",
        "decisions",
        "updates",
        "wall_seconds",
        "circuit_evaluations",
        "shots",
        "cpu_core_hours",
        "gpu_device_hours"
      ]
    },
    "evaluation": {
      "type": "object",
      "required": [
        "policy_mode",
        "checkpoint_selection",
        "metrics_protocol"
      ],
      "description": "Declare greedy/stochastic, checkpoint policy, episode termination and metric denominators."
    },
    "artifacts": {
      "type": "string",
      "const": "artifact_manifest.json"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "description": "Failure mode, traceback/log path, valid data, attempts, and next action."
    },
    "publication": {
      "type": "object",
      "required": [
        "status",
        "source_remote_verified"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "blocked"
          ]
        },
        "source_remote_verified": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": true,
  "$comment": "Stage 01 implements JSON Schema validation plus cross-file checks, runtime checks and artifact hash verification. A syntactically valid manifest alone does not prove an experiment happened or was published."
}
